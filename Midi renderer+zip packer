# multi_track_midi.py
import io
import zipfile
import pretty_midi
import json

def render_midi_pack(beat_plan):
    """Generate multi-track MIDI files and pack into ZIP."""
    zip_buffer = io.BytesIO()

    with zipfile.ZipFile(zip_buffer, 'w') as zf:
        # 1. Chords MIDI
        chords = beat_plan.get('chords', [])
        if chords:
            midi_data = chord_to_midi(chords, beat_plan.get('tempo', 78))
            zf.writestr('chords.mid', midi_data)

        # 2. Drums MIDI
        drum_grid = beat_plan.get('drum_grid', {})
        velocities = beat_plan.get('velocities', {})
        if drum_grid:
            midi_data = drums_to_midi(drum_grid, velocities, beat_plan.get('tempo', 78))
            zf.writestr('drums.mid', midi_data)

        # 3. Bass MIDI
        bass = beat_plan.get('bass_pattern', {})
        if bass:
            midi_data = bass_to_midi(bass, beat_plan.get('tempo', 78))
            zf.writestr('bass.mid', midi_data)

        # 4. Layers (placeholders)
        layers = beat_plan.get('layers', [])
        for i, layer in enumerate(layers):
            # simplified: just pass through notes
            # In reality, this would render each layer separately
            pass

        # 5. README.txt
        readme = f"""
Beat Pack generated by Barksdale Music Group

Producers: {beat_plan.get('producer', 'Unknown')}
Genre: {beat_plan.get('genre', 'Unknown')}
Emotion: {beat_plan.get('emotion', 'Unknown')}
Tempo: {beat_plan.get('tempo', 78)} BPM
Key: {beat_plan.get('key', 'Unknown')}

Chords: {beat_plan.get('chord_progression_line', '')}

Mix Summary:
{json.dumps(beat_plan.get('mix_summary', {}), indent=2)}

Mastering:
LUFS: {beat_plan.get('master', {}).get('lufs', -9)}
True Peak: {beat_plan.get('master', {}).get('true_peak', -1.0)}
"""
        zf.writestr('README.txt', readme)

        # 6. template.json
        zf.writestr('template.json', json.dumps(beat_plan, indent=2))

    return zip_buffer.getvalue()


def chord_to_midi(chords, bpm=78):
    """Convert chord progression to MIDI bytes."""
    midi = pretty_midi.PrettyMIDI(initial_tempo=bpm)
    piano = pretty_midi.Instrument(program=0, name='Piano')
    # Map chords to notes (simplified)
    chord_map = {
        'Cm': [60, 63, 67],
        'Ab': [68, 72, 75],
        'Fm': [65, 68, 72],
        'G': [67, 71, 74],
        'C': [60, 64, 67],
        'G': [67, 71, 74],
        'Am': [69, 72, 76],
        'F': [65, 69, 72],
        'Bb': [70, 74, 77],
        # add more as needed
    }
    sec_per_bar = 60 / bpm * 4
    for i, chord in enumerate(chords):
        notes = chord_map.get(chord, [60, 64, 67])  # default C
        start = i * sec_per_bar
        end = start + sec_per_bar
        for note in notes:
            note_obj = pretty_midi.Note(velocity=100, pitch=note, start=start, end=end)
            piano.notes.append(note_obj)
    midi.instruments.append(piano)
    with io.BytesIO() as f:
        midi.write(f)
        return f.getvalue()


def drums_to_midi(drum_grid, velocities, bpm=78):
    """Convert drum grid to MIDI bytes."""
    midi = pretty_midi.PrettyMIDI(initial_tempo=bpm)
    drum_track = pretty_midi.Instrument(program=0, is_drum=True, name='Drums')
    drum_map = {
        'kick': 36,
        'snare': 38,
        'hat': 42,
        'open_hat': 46,
        'rim': 37,
        'percussion': 68
    }
    sec_per_step = (60 / bpm) / 4  # 16th note duration
    for instr, pattern in drum_grid.items():
        note_num = drum_map.get(instr)
        if not note_num:
            continue
        vel_pattern = velocities.get(instr, [])
        for step, hit in enumerate(pattern):
            if hit:
                vel = vel_pattern[step] if step < len(vel_pattern) else 80
                start = step * sec_per_step
                end = start + sec_per_step * 0.5
                note_obj = pretty_midi.Note(velocity=vel, pitch=note_num, start=start, end=end)
                drum_track.notes.append(note_obj)
    midi.instruments.append(drum_track)
    with io.BytesIO() as f:
        midi.write(f)
        return f.getvalue()


def bass_to_midi(bass, bpm=78):
    """Convert bass pattern to MIDI bytes."""
    midi = pretty_midi.PrettyMIDI(initial_tempo=bpm)
    bass_track = pretty_midi.Instrument(program=33, name='Electric Bass')
    notes = bass.get('notes', [])
    velocities = bass.get('velocities', [])
    sec_per_step = (60 / bpm) / 4
    for step, pitch in enumerate(notes):
        if pitch:
            vel = velocities[step] if step < len(velocities) else 80
            start = step * sec_per_step
            end = start + sec_per_step * 3  # sustain
            note_obj = pretty_midi.Note(velocity=vel, pitch=pitch, start=start, end=end)
            bass_track.notes.append(note_obj)
    midi.instruments.append(bass_track)
    with io.BytesIO() as f:
        midi.write(f)
        return f.getvalue()
