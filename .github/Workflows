generate-beat.yml
name: Generate Beat Pack

on:
  workflow_dispatch:
    inputs:
      genre:
        description: 'Genre (e.g., Boom Bap, Trap)'
        required: false
        default: 'Boom Bap'
      key:
        description: 'Key (e.g., C Minor)'
        required: false
        default: 'C Minor'
      tempo:
        description: 'Tempo (BPM)'
        required: false
        default: '78'
      emotion:
        description: 'Emotion (Dark, Soulful, etc.)'
        required: false
        default: 'Dark'
  push:
    paths:
      - 'beat_engine.py'
      - 'multi_track_midi.py'

jobs:
  generate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Install dependencies
        run: |
          pip install pretty_midi

      - name: Run generator
        run: |
          # Create a sample input JSON based on workflow inputs
          echo "{\"primary_producer\": \"Conductor Williams\", \"genre\": \"${{ github.event.inputs.genre }}\", \"emotion\": \"${{ github.event.inputs.emotion }}\", \"tempo\": ${{ github.event.inputs.tempo }}, \"key\": \"${{ github.event.inputs.key }}\"}" > input.json
          # For simplicity, we'll generate a dummy beat pack (in reality you'd run your full engine)
          python -c "from multi_track_midi import render_midi_pack; from beat_engine import generate_beat; import json; with open('input.json') as f: params=json.load(f); beat=generate_beat(params); z=render_midi_pack(beat); open('beat_pack.zip','wb').write(z)"

      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: claude-beats-pack
          path: beat_pack.zip
