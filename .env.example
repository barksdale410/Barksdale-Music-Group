# ===========================================
# BARKSDALE MUSIC GROUP - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# Server Configuration
PORT=8001
FLASK_ENV=development
APP_URL=https://barksdale-music-group.onrender.com

# ===========================================
# BANDLAB API (Optional)
# ===========================================
# Get credentials at: https://api.bandlab.com/
BANDLAB_CLIENT_ID=your_client_id_here
BANDLAB_CLIENT_SECRET=your_client_secret_here

# ===========================================
# STRIPE (Premium Payments)
# ===========================================
# Get keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ===========================================
# DATABASE (Optional - for production)
# ===========================================
# PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/barksdale

# MongoDB
# MONGODB_URI=mongodb://localhost:27017/barksdale

# ===========================================
# REDIS (Optional - for caching)
# ===========================================
# REDIS_URL=redis://localhost:6379

# ===========================================
# API KEYS
# ===========================================
# AI Service (optional)
# OPENAI_API_KEY=sk-your-openai-key
# ANTHROPIC_API_KEY=sk-ant-your-key

# ===========================================
# SECURITY
# ===========================================
# Secret key for Flask sessions
SECRET_KEY=your-super-secret-key-change-in-production

# ===========================================
# RATE LIMITING
# ===========================================
# Rate limit for API (requests per minute)
# RATE_LIMIT=60
